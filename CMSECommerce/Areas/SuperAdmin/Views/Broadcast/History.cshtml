@model List<BroadcastMessage>

<h2>Broadcast History</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Sent By</th>
            <th>Date</th>
            <th>Recipients</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Subject</td>
                <td>@item.SentByUser?.UserName</td>
                <td>@item.DateSent.ToLocalTime()</td>
                <td>@item.RecipientCount</td>
                <td>
                    <span class="badge bg-info">@item.Status</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>