@model BroadcastMessage

<h2>Broadcast Details</h2>

<div>
    <h4>@Model.Subject</h4>
    <p>@Html.Raw(Model.Body)</p>
    <p><strong>Sent On:</strong> @Model.DateSent</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

<hr />

<h3>Recipients</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Status</th>
            <th>Sent At</th>
            <th>Error</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Recipients)
        {
            <tr>
                <td>@r.Email</td>
                <td>
                    <span class="badge bg-@(r.Status == "Sent" ? "success" : r.Status == "Failed" ? "danger" : "secondary")">
                        @r.Status
                    </span>
                </td>
                <td>@r.SentAt</td>
                <td>@r.ErrorMessage</td>
            </tr>
        }
    </tbody>
</table>