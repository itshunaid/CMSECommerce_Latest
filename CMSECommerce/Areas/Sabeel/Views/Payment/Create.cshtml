@model SabeelPaymentDetail

@{
    ViewData["Title"] = "Sabeel Payment Portal";
    ViewData["HideLayoutSidebar"] = true;
    string upiId = "abbaszoher51-1@oksbi";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary: #21409a;
        --primary-light: #2d5aa8;
        --secondary: #f39c12;
        --success: #27ae60;
        --danger: #e74c3c;
        --light-bg: #f8f9fa;
        --border-color: #e0e6ed;
        --text-secondary: #7f8c8d;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
        padding: 10px;
    }

    .payment-card {
        width: 100%;
        max-width: 520px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        margin: 20px auto;
        overflow: hidden;
    }

    .payment-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        color: white;
        padding: 30px 25px;
        text-align: center;
    }

    .payment-header h1 {
        font-size: 28px;
        margin-bottom: 5px;
    }

    .payment-header p {
        font-size: 14px;
        opacity: 0.9;
    }

    .payment-body {
        padding: 25px;
    }

    .form-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-secondary);
        margin-bottom: 8px;
        letter-spacing: 0.5px;
    }

    .form-group {
        position: relative;
        margin-bottom: 18px;
    }

    .form-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary);
        z-index: 5;
        font-size: 16px;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px 12px 45px;
        border: 2px solid var(--border-color);
        border-radius: 10px;
        transition: all 0.3s ease;
        font-size: 14px;
    }

    .form-control:focus {
        border-color: var(--primary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(33, 64, 154, 0.1);
    }

    .form-control::placeholder {
        color: #bdc3c7;
    }

    /* Amount Box */
    .amount-box {
        background: #f8fafc;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .amount-box:focus-within {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(33, 64, 154, 0.1);
    }

    .currency-symbol {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-weight: bold;
        color: var(--secondary);
        font-size: 18px;
    }

    .amount-box .form-control {
        padding-left: 35px;
        font-size: 18px;
        font-weight: bold;
    }

    /* QR Section - DESKTOP ONLY */
    .qr-section {
        display: block;
        background: var(--light-bg);
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        padding: 25px;
        text-align: center;
        margin-bottom: 20px;
        animation: slideDown 0.3s ease;
    }

    .qr-section h4 {
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .qr-code-image {
        width: 160px;
        height: 160px;
        padding: 8px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .qr-section p {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 12px;
    }

    /* Mobile Pay Section - MOBILE ONLY */
    .mobile-pay-section {
        display: none;
        margin-bottom: 20px;
        animation: slideDown 0.3s ease;
    }

    .mobile-pay-section.active {
        display: block;
    }

    /* Server-side device detection takes priority */
    [data-device="mobile"] .qr-section {
        display: none !important;
    }

    [data-device="mobile"] .mobile-pay-section {
        display: block !important;
    }

    [data-device="desktop"] .qr-section {
        display: block !important;
    }

    [data-device="desktop"] .mobile-pay-section {
        display: none !important;
    }

    .pay-instruction {
        background: rgba(33, 64, 154, 0.08);
        border-left: 4px solid var(--primary);
        padding: 12px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
        font-size: 13px;
        color: var(--primary);
    }

    .btn-upi-mobile {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, var(--success) 0%, #229954 100%);
        color: white;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.2);
        transition: all 0.3s ease;
    }

    .btn-upi-mobile:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(39, 174, 96, 0.3);
    }

    .btn-upi-mobile:active {
        transform: translateY(0);
    }

    .mobile-info {
        text-align: center;
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 10px;
    }

    /* Buttons */
    .button-group {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-back {
        flex: 1;
        padding: 12px;
        background: var(--light-bg);
        color: var(--text-secondary);
        border: 2px solid var(--border-color);
        border-radius: 10px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-back:hover {
        background: white;
        color: var(--primary);
        border-color: var(--primary);
    }

    .btn-submit {
        flex: 1;
        padding: 12px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 14px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(33, 64, 154, 0.2);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(33, 64, 154, 0.3);
    }

    .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        body {
            padding: 5px;
        }

        .payment-card {
            margin: 5px auto;
            border-radius: 12px;
            max-width: 100%;
        }

        .payment-header {
            padding: 20px;
        }

        .payment-header h1 {
            font-size: 22px;
        }

        .payment-header p {
            font-size: 12px;
        }

        .payment-body {
            padding: 15px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control {
            padding: 14px 15px 14px 45px;
            font-size: 16px;
        }

        .amount-box {
            padding: 15px;
            margin-bottom: 15px;
        }

        .amount-box .form-control {
            padding-left: 35px;
            font-size: 20px;
        }

        .qr-section {
            display: none !important;
        }

        .mobile-pay-section {
            display: block !important;
        }

        .button-group {
            flex-direction: column;
            gap: 8px;
        }

        .btn-back,
        .btn-submit {
            flex: none;
            width: 100%;
            padding: 14px;
        }

        .btn-submit {
            font-size: 13px;
        }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    .qr-section, .mobile-pay-section {
    display: none; /* Hide both by default */

    /* Show QR on screens larger than 768px (Desktop-ish) */
@@media (min-width: 769px) {
    .qr-section {
        display: block;
    }
}

/* Show Pay Button on screens 768px or smaller (Mobile-ish) */
@@media (max-width: 768px) {
    .mobile-pay-section {
        display: block;
    }
}


}
</style>

<div class="payment-card" data-device="@ViewBag.DeviceType" id="paymentCard">
    <div class="payment-header">
        <i class="fas fa-hand-holding-heart fa-2x mb-3"></i>
        <h1>Sabeel Payment</h1>
        <p>Secure Digital Contribution</p>
    </div>

    <div class="payment-body">
        <form id="mainPaymentForm" method="post">
            @Html.AntiForgeryToken()

            <!-- Full Name -->
            <div class="form-group">
                <label class="form-label">Full Name</label>
                <i class="fas fa-user form-icon"></i>
                <input type="text" name="FullName" id="fullName" class="form-control" placeholder="Enter your full name" required />
            </div>

            <!-- ITS Number -->
            <div class="form-group">
                <label class="form-label">ITS Number</label>
                <i class="fas fa-id-card form-icon"></i>
                <input type="text" name="ITSNumber" id="itsNumber" class="form-control" placeholder="8-Digit ITS" inputmode="numeric" maxlength="8" minlength="8" required />
            </div>

            <!-- Amount -->
            <div class="amount-box">
                <label class="form-label">Amount (₹)</label>
                <div style="position: relative;">
                    <span class="currency-symbol">₹</span>
                    <input type="number" name="Amount" id="amountInput" class="form-control" placeholder="0.00" step="0.01" min="1" required />
                </div>
            </div>

            <!-- DESKTOP: QR Code Section -->
            <div class="qr-section" id="qrContainer">
                <h4>Scan to Pay</h4>
                <img id="qrImage" src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=upi://pay?pa=@upiId" class="qr-code-image" alt="UPI QR Code" />
                <p><i class="fas fa-camera"></i> Scan with any UPI App</p>
            </div>

            <!-- MOBILE: Pay Button Section -->
            <div class="mobile-pay-section" id="mobilePaySection">
                <div class="pay-instruction">
                    <i class="fas fa-info-circle"></i> Tap below to pay via your UPI app (GPay, PhonePe, Paytm, etc.)
                </div>
                <a href="upi://pay?pa=@upiId" id="mobileUpiLink" class="btn-upi-mobile">
                    <i class="fas fa-mobile-screen fa-lg"></i> 
                    <span>Pay via UPI App</span>
                </a>
                <div class="mobile-info">
                    <i class="fas fa-check-circle"></i> After payment, return here and fill UTR
                </div>
            </div>

            <!-- UTR Number -->
            <div class="form-group">
                <label class="form-label">UTR / Transaction ID</label>
                <i class="fas fa-receipt form-icon"></i>
                <input type="text" name="UTRNumber" id="utrNumber" class="form-control" placeholder="12-digit UTR Number" inputmode="numeric" maxlength="12" minlength="12" required />
                <small style="display: block; margin-top: 5px; color: var(--text-secondary);">
                    <i class="fas fa-help-circle"></i> Find this in your payment confirmation
                </small>
            </div>

            <!-- Buttons -->
            <div class="button-group">
                <a href="/Sabeel/Payment/Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
                <button type="submit" class="btn-submit" id="submitBtn">
                    <i class="fas fa-paper-plane"></i> Submit
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const form = document.getElementById('mainPaymentForm');
        const paymentCard = document.getElementById('paymentCard');
        const amountInput = document.getElementById('amountInput');
        const itsInput = document.getElementById('itsNumber');
        const qrImage = document.getElementById('qrImage');
        const mobileLink = document.getElementById('mobileUpiLink');
        const qrContainer = document.getElementById('qrContainer');
        const mobilePaySection = document.getElementById('mobilePaySection');
        const upiId = "@upiId";

        // Log initial device detection from server
        console.log('📱 Device Detection:', {
            serverDetected: paymentCard.getAttribute('data-device'),
            userAgent: navigator.userAgent.substring(0, 80)
        });

        // Fallback: If server-side detection fails, use client-side as backup
        function ensureCorrectUI() {
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth <= 768;
    
    if (isMobile) {
        qrContainer.style.setProperty('display', 'none', 'important');
        mobilePaySection.style.setProperty('display', 'block', 'important');
        console.log("Switching to Mobile View");
    } else {
        qrContainer.style.setProperty('display', 'block', 'important');
        mobilePaySection.style.setProperty('display', 'none', 'important');
        console.log("Switching to Desktop View");
    }
}

        // Update UPI links when amount or ITS changes
        function updateUpiLinks() {
            const amount = amountInput.value || '0';
            const its = itsInput.value || 'Sabeel';

            // Build UPI string
            const upiString = `upi://pay?pa=${upiId}&am=${amount}&cu=INR&tn=ITS-${its}`;

            // Update QR (Desktop)
            if (qrImage) {
                qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(upiString)}`;
            }

            // Update Deep Link (Mobile)
            if (mobileLink) {
                mobileLink.href = upiString;
            }
        }

        // Form submission with validation and confirmation
        form.addEventListener('submit', function (e) {
            e.preventDefault();

            // Get form values
            const fullName = document.getElementById('fullName').value.trim();
            const itsNumber = document.getElementById('itsNumber').value.trim();
            const amount = document.getElementById('amountInput').value.trim();
            const utrNumber = document.getElementById('utrNumber').value.trim();

            // Validate all fields
            let isValid = true;
            let errorMsg = '';

            if (!fullName) {
                errorMsg += '• Full Name is required\n';
                isValid = false;
            }

            if (!itsNumber || itsNumber.length !== 8 || !/^\d+$/.test(itsNumber)) {
                errorMsg += '• ITS Number must be exactly 8 digits\n';
                isValid = false;
            }

            if (!amount || parseFloat(amount) <= 0) {
                errorMsg += '• Amount must be greater than 0\n';
                isValid = false;
            }

            if (!utrNumber || utrNumber.length !== 12 || !/^\d+$/.test(utrNumber)) {
                errorMsg += '• UTR Number must be exactly 12 digits\n';
                isValid = false;
            }

            if (!isValid) {
                Swal.fire({
                    title: 'Validation Error',
                    text: errorMsg,
                    icon: 'error',
                    confirmButtonColor: '#21409a'
                });
                return false;
            }

            // Show confirmation dialog
            Swal.fire({
                title: 'Confirm Payment Details',
                html: `
                    <div style="text-align: left; font-size: 14px; margin: 20px 0;">
                        <div style="margin: 12px 0; padding: 10px; background: #f8f9fa; border-radius: 6px;">
                            <strong style="color: #21409a;">Name:</strong><br>
                            <span>${escapeHtml(fullName)}</span>
                        </div>
                        <div style="margin: 12px 0; padding: 10px; background: #f8f9fa; border-radius: 6px;">
                            <strong style="color: #21409a;">ITS Number:</strong><br>
                            <span>${itsNumber}</span>
                        </div>
                        <div style="margin: 12px 0; padding: 10px; background: #f8f9fa; border-radius: 6px;">
                            <strong style="color: #21409a;">Amount:</strong><br>
                            <span style="font-size: 18px; font-weight: bold; color: #27ae60;">₹${parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                        </div>
                        <div style="margin: 12px 0; padding: 10px; background: #f8f9fa; border-radius: 6px;">
                            <strong style="color: #21409a;">UTR Number:</strong><br>
                            <span>${utrNumber}</span>
                        </div>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#21409a',
                cancelButtonColor: '#95a5a6',
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false
            }).then((result) => {
                if (result.isConfirmed) {
                    // Submit the form for real
                    form.submit();
                }
            });

            return false;
        });

        // Helper function to escape HTML
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 DOM loaded, verifying device detection...');
            ensureCorrectUI();
            updateUpiLinks();
        });

        // Re-check on resize
        window.addEventListener('resize', function() {
            console.log('📐 Window resized, verifying UI...');
            ensureCorrectUI();
        });

        // Update UPI links on input changes
        amountInput.addEventListener('input', updateUpiLinks);
        itsInput.addEventListener('input', updateUpiLinks);

        // Initial call
        console.log('📡 Scripts loaded...');
        ensureCorrectUI();
        updateUpiLinks();
    </script>
}
