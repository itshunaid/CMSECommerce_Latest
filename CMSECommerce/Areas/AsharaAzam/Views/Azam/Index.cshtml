@model AzamEntryViewModel
@{
    ViewData["Title"] = "My Ashara Azam";
}

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,700;1,700&family=Inter:wght@300;400;600;700&family=Amiri:wght@400;700&display=swap" rel="stylesheet">

<style>
    :root {
        --gold-light: #f3e5ab;
        --gold-primary: #c5a059;
        --gold-deep: #947436;
        --dark-bg: #121212;
        --glass-bg: rgba(255, 255, 255, 0.95);
        --text-main: #2d3436;
    }

    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: #fdfcf8;
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;

        background-image: 
            radial-gradient(circle at 2px 2px, rgba(197, 160, 89, 0.1) 1px, transparent 0);
        background-size: 24px 24px;
    }

    /* 🔴 DARK RED YA HUSSAIN WATERMARK */
    .watermark-layer {
        position: fixed;
        inset: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        align-content: space-around;
        opacity: 0.08;
        font-family: 'Amiri', serif;
        font-size: 5rem;
        pointer-events: none;
        z-index: 0;
        user-select: none;
        color: rgba(153, 0, 0, 0.72);
    }

    .premium-container {
        width: 100%;
        max-width: 500px;
        padding: 20px;
        position: relative;
        z-index: 10;
    }

    .azam-card {
        background: var(--glass-bg);
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(148, 116, 54, 0.15);
        border: 1px solid rgba(197, 160, 89, 0.3);
        overflow: hidden;
        position: relative;
        backdrop-filter: blur(2px);
    }

    .card-top-design {
        height: 8px;
        background: linear-gradient(90deg, var(--gold-deep), var(--gold-primary), var(--gold-light), var(--gold-primary), var(--gold-deep));
    }

    /* ⬇️ HEADING VISIBLY LOWER */
    .azam-header {
    padding: 35px 30px 20px; /* slightly increased top padding */
    margin-top: 110px;        /* subtle downward shift */
    text-align: center;
}

    .azam-header h1 {
        font-family: 'Bodoni Moda', serif;
        font-size: 2.4rem;
        color: var(--gold-deep);
        margin: 0;
        letter-spacing: -0.5px;
    }

    .azam-header .subtitle {
        font-family: 'Amiri', serif;
        font-size: 1.4rem;
        color: var(--gold-primary);
        margin-top: 5px;
        display: block;
    }

    .form-body {
        padding: 0 35px 40px;
    }

    .input-group {
        position: relative;
        margin-bottom: 25px;
    }

    .input-group label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--gold-deep);
        margin-bottom: 8px;
    }

    .azam-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #fff;
    }

    .azam-input:focus {
        outline: none;
        border-color: var(--gold-primary);
        box-shadow: 0 0 0 4px rgba(197, 160, 89, 0.1);
    }

    .niyyat-section {
        background: linear-gradient(to bottom right, #ffffff, #fffdf9);
        border: 1px dashed var(--gold-primary);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .niyyat-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px 0;
    }

    .niyyat-list li {
        font-size: 0.92rem;
        line-height: 1.6;
        margin-bottom: 12px;
        padding-left: 25px;
        position: relative;
        color: #444;
    }

    .niyyat-list li::before {
        content: "◈";
        position: absolute;
        left: 0;
        color: var(--gold-primary);
        font-size: 14px;
    }

    .consent-container {
        display: flex;
        align-items: center;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--gold-deep);
        gap: 12px;
        padding: 10px;
        border-radius: 8px;
        transition: background 0.2s;
    }

    .consent-container:hover {
        background: rgba(197, 160, 89, 0.05);
    }

    .consent-container input {
        width: 20px;
        height: 20px;
        accent-color: var(--gold-deep);
        cursor: pointer;
    }

    .btn-submit {
        width: 100%;
        background: var(--dark-bg);
        color: var(--gold-light);
        border: none;
        padding: 18px;
        border-radius: 14px;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .btn-submit:hover {
        background: var(--gold-deep);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(148, 116, 54, 0.3);
    }

    .btn-submit:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }

    .alert-premium {
        background: #fff5f5;
        border-left: 4px solid #f56565;
        color: #c53030;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    @@media (max-width: 480px) {
        .azam-header h1 { font-size: 1.8rem; }
        .form-body { padding: 0 20px 30px; }
        .premium-container { padding: 10px; }
    }
</style>

<div class="watermark-layer">
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
    <span>يا حسين</span><span>يا حسين</span><span>يا حسين</span>
</div>

<div class="premium-container">
    <div class="azam-card">
        <div class="card-top-design"></div>       
        <header class="azam-header">
            <h1>My Ashara Azam</h1>
            <span class="subtitle">عشرة مباركة</span>
        </header>

        <div class="form-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert-premium">
                    @TempData["Message"]
                </div>
            }

            <form asp-action="Index" method="post" id="azamForm">
                @Html.AntiForgeryToken()

                <div class="input-group">
                    <label>ITS Number</label>
                    <input asp-for="ITSNumber" name="ITSNumber"
                           class="azam-input"
                           type="tel"
                           placeholder="8-digit ID"
                           required maxlength="8" 
                           oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1');" />
                </div>

                <div class="input-group">
                    <label>Full Name</label>
                    <input asp-for="FullName" name="FullName"
                           class="azam-input"
                           placeholder="Enter your name"
                           required />
                </div>

                <div class="niyyat-section">
                    <ul class="niyyat-list">
                        <li>I will keep my business 100% closed.</li>
                        <li>I will take leave from my professional job.</li>
                        <li>I will take leave from my academic studies.</li>
                        <li>I will arrive before time for all Majalis.</li>
                    </ul>

                    <label class="consent-container" for="consent">
                        <input asp-for="ConsentGiven" name="ConsentGiven"
                               type="checkbox" id="consent"
                               value="true" required />
                        <span>I solemnly affirm this Azam.</span>
                    </label>
                    <input name="ConsentGiven" type="hidden" value="false" />
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    Confirm Azam Niyyat
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('azamForm').onsubmit = function () {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = "Submitting Niyyat...";
        return true;
    };
</script>