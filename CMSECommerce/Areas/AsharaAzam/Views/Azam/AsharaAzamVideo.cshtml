@model AsharaAzamEntry

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- LIBRARIES -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Cinzel:wght@600&family=Inter:wght@400;500&display=swap" rel="stylesheet">

    <style>
        body {
        margin: 0;
        background: #eee;
        font-family: 'Inter', sans-serif;
        text-align: center;
        }

        /* CERTIFICATE */
        #certificate {
        width: 1024px;
        height: 722px;
        margin: 20px auto;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        background: #fff;
        }

        /* BACKGROUND */
        .bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image: url('/images/floral-bg.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        }

        .bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.85);
        }

        /* BORDERS */
        .border {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 12px;
        bottom: 12px;
        border: 3px solid #C59F46;
        z-index: 3;
        }

        .inner-border {
        position: absolute;
        top: 25px;
        left: 25px;
        right: 25px;
        bottom: 25px;
        border: 1px solid rgba(197,159,70,0.6);
        z-index: 3;
        }

        /* WATERMARK */
        .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-25deg);
        font-size: 90px;
        color: rgba(180, 0, 0, 0.06);
        font-family: 'Cinzel', serif;
        z-index: 1;
        white-space: nowrap;
        }

        /* CONTENT */
        .content {
        position: absolute;
        top: 90px;
        left: 120px;
        right: 120px;
        z-index: 5;
        }

        .logo {
        width: 75px;
        margin-bottom: 10px;
        }

        .title {
        font-family: 'Cinzel', serif;
        font-size: 34px;
        color: #004E50;
        letter-spacing: 2px;
        }

        .subtitle {
        font-size: 14px;
        color: #555;
        margin-top: 6px;
        }

        .name {
        font-family: 'Playfair Display', serif;
        font-size: 34px;
        color: #C59F46;
        margin-top: 18px;
        }

        .its {
        font-size: 15px;
        color: #004E50;
        margin-top: 5px;
        }

        .header {
        margin-top: 22px;
        font-size: 16px;
        font-weight: 500;
        color: #333;
        }

        .list {
        text-align: left;
        margin-top: 15px;
        padding-left: 30px;
        font-size: 14px;
        line-height: 1.8;
        color: #333;
        }

        .list li::marker {
        color: #C59F46;
        }

        /* FOOTER */
        .footer {
        position: absolute;
        bottom: 40px;
        width: 100%;
        z-index: 5;
        font-size: 13px;
        }

        .footer b {
        color: #004E50;
        }

        /* BUTTONS */
        .actions, .mobile-only {
        margin-top: 15px;
        }

        button {
        padding: 10px 18px;
        background: linear-gradient(135deg, #004E50, #007a7c);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        margin: 6px;
        font-size: 14px;
        }

        button:hover {
        opacity: 0.9;
        }

        /* MOBILE LOGIC */
        .mobile-only {
        display: none;
        }

        .desktop-only {
        display: block;
        }

        @@media(max - width: 768px)

        {

        #certificate {
        display: none !important;
        }

        .desktop-only {
        display: none;
        }

        .mobile-only {
        display: block;
        padding: 30px 20px;
        }

        .mobile-note {
        font-size: 15px;
        color: #333;
        margin-bottom: 15px;
        line-height: 1.6;
        }
        }

    </style>
</head>

<body>

    <!-- CERTIFICATE (DESKTOP ONLY) -->
    <div id="certificate">

        <div class="bg"></div>

        <div class="watermark">YA HUSSAIN</div>

        <div class="border"></div>
        <div class="inner-border"></div>

        <div class="content">

            <img src="/images/logo.png" class="logo" crossorigin="anonymous" />

            <div class="title">MY ASHARA AZAM</div>
            <div class="subtitle">Acknowledging the sincere Niyyat of</div>

            <div class="name">@Model.FullName.ToUpper()</div>
            <div class="its">ITS ID: @Model.ITSNumber</div>

            <div class="header">
                Mein Em Azam Karoon Choon Ke Ashara Mubaraka Ma Mein:
            </div>

            <ul class="list">
                <li>Maro Business 100% close raakhis.</li>
                <li>Job Si Raza Lay-Lais.</li>
                <li>Studies Si Raza Lay-Lais.</li>
                <li>Qablal Waqt Waaz ni Majalis Ma Hazir Rahis.</li>
            </ul>

        </div>

        <div class="footer">
            <div><b>ANJUMAN E BURHANI</b></div>
            <div>Hussaini Alam, Hyderabad</div>
            <div><b>DATE: @DateTime.Now.ToString("dd MMM yyyy")</b></div>
        </div>

    </div>

    <!-- DESKTOP BUTTONS -->
    <div class="actions desktop-only">
        <button onclick="downloadVideo()">HD Video</button>
        <button onclick="downloadImageHD()">HD Image</button>
        <button onclick="downloadImage()">Normal Image</button>
        <button onclick="downloadPDF()">Download PDF</button>
    </div>

    <!-- MOBILE VIEW -->
    <div class="mobile-only">

        <div class="mobile-note">
            📱 For best experience, download your certificate using the options below.<br />
            Preview is optimized for desktop viewing.
        </div>

        <button onclick="downloadVideo()">HD Video</button>
        <button onclick="downloadImageHD()">HD Image</button>
        <button onclick="downloadImage()">Normal Image</button>
        <button onclick="downloadPDF()">Download PDF</button>

    </div>

    <script>

        /* WAIT FOR IMAGES */
        function waitForImages() {
        const imgs = document.querySelectorAll("img");
        return Promise.all([...imgs].map(img =>
        img.complete ? Promise.resolve() :
        new Promise(res => img.onload = res)
        ));
        }

        /* IMAGE */
        async function downloadImage() {
        await waitForImages();

        const canvas = await html2canvas(document.getElementById("certificate"), {
        scale: 2,
        useCORS: true,
        allowTaint: true,
        backgroundColor: null
        });

        downloadCanvas(canvas, "certificate.png");
        }

        /* HD IMAGE */
        async function downloadImageHD() {
        await waitForImages();

        const canvas = await html2canvas(document.getElementById("certificate"), {
        scale: 4,
        useCORS: true,
        allowTaint: true,
        backgroundColor: null
        });

        downloadCanvas(canvas, "certificate-hd.png");
        }

        function downloadCanvas(canvas, filename) {
        const a = document.createElement("a");
        a.href = canvas.toDataURL("image/png");
        a.download = filename;
        a.click();
        }

        /* PDF */
        async function downloadPDF() {
        await waitForImages();

        const { jsPDF } = window.jspdf;

        const canvas = await html2canvas(document.getElementById("certificate"), {
        scale: 3,
        useCORS: true,
        allowTaint: true,
        backgroundColor: null
        });

        const imgData = canvas.toDataURL("image/png");

        const pdf = new jsPDF({
        orientation: "landscape",
        unit: "px",
        format: [1024, 722]
        });

        pdf.addImage(imgData, "PNG", 0, 0, 1024, 722);
        pdf.save("certificate.pdf");
        }

        /* VIDEO */
        async function downloadVideo() {

        await waitForImages();

        const element = document.getElementById("certificate");

        const canvas = document.createElement("canvas");
        canvas.width = 1280;
        canvas.height = 720;

        const ctx = canvas.getContext("2d");

        const stream = canvas.captureStream(25);

        // ✅ AUDIO
        const audio = new Audio('/audio/ya-hussain.mp3');
        audio.crossOrigin = "anonymous";

        const audioCtx = new AudioContext();
        const source = audioCtx.createMediaElementSource(audio);
        const dest = audioCtx.createMediaStreamDestination();

        source.connect(dest);
        source.connect(audioCtx.destination);

        const combinedStream = new MediaStream([
        ...stream.getTracks(),
        ...dest.stream.getTracks()
        ]);

        // ✅ MIME fallback
        let mimeType = "";
        if (MediaRecorder.isTypeSupported("video/webm;codecs=vp8")) {
        mimeType = "video/webm;codecs=vp8";
        } else {
        mimeType = "video/webm";
        }

        const recorder = new MediaRecorder(combinedStream, {
        mimeType: mimeType,
        videoBitsPerSecond: 5 * 1024 * 1024
        });

        let chunks = [];

        recorder.ondataavailable = e => {
        if (e.data.size > 0) chunks.push(e.data);
        };

        recorder.onstop = () => {

        const blob = new Blob(chunks, { type: mimeType });

        // ✅ MP4 workaround
        const file = new File([blob], "certificate-whatsapp.mp4", {
        type: "video/mp4"
        });

        const url = URL.createObjectURL(file);

        const a = document.createElement("a");
        a.href = url;
        a.download = file.name;
        a.click();

        URL.revokeObjectURL(url);
        };

        recorder.start();

        // ✅ START AUDIO
        await audio.play();

        // ✅ DRAW LOOP
        async function draw() {

        const temp = await html2canvas(element, {
        scale: 2,
        useCORS: true,
        backgroundColor: "#ffffff"
        });

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(temp, 0, 0, canvas.width, canvas.height);

        if (!audio.ended) {
        requestAnimationFrame(draw);
        } else {
        recorder.stop();
        }
        }

        draw();
        }

    </script>

</body>
</html>