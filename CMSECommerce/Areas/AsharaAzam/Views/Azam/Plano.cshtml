</div>

<audio id="bgAudio" loop>
    <source src="/audio/ya-hussain.mp3" type="audio/mpeg">
</audio>

<button id="audioToggle" class="audio-fab" title="Toggle Sound">
    <span id="audioIcon">🔈</span>
</button>

<div class="main-wrapper">
    @* <div class="video-container">
        <iframe
            src="https://www.youtube.com/embed/sCID2SBEgk4?autoplay=1&mute=1&loop=1&playlist=sCID2SBEgk4&controls=1&enablejsapi=1"
            title="Ashara Video"
            allow="autoplay; encrypted-media"
            allowfullscreen>
        </iframe>
    </div> *@
    @* <div class="image-container">
        <img src="~/images/MufaddalMoula.jpg" alt="Moula" />
    </div> *@
    <div class="premium-container">
        <div class="count-badge">
            <span class="count-label">Total Azam Submitted</span>
            <span class="count-number">@ViewBag.TotalAzamCount</span>
        </div>
        <div class="azam-card">
            <div class="card-top-design"></div>

            <header class="azam-header">
                <div class="logo-wrapper">
                    <img src="~/images/logo.png" alt="Logo" asp-append-version="true" />
                </div>
                <h1>My Ashara Azam</h1>
                <span class="subtitle">عشرة مباركة</span>
            </header>

            <div class="form-body">
                @if (TempData["Message"] != null)
                {
                    <div style="background:#fff5f5; color:#c53030; padding:12px; border-radius:8px; margin-bottom:20px; font-size:0.85rem; font-weight:600; border-left:4px solid #f56565;">
                        @TempData["Message"]
                    </div>
                }

                <form asp-action="Index" method="post" id="azamForm">
                    @Html.AntiForgeryToken()

                    <div class="input-group">
                        <label>ITS Number</label>
                        <input asp-for="ITSNumber" name="ITSNumber" class="azam-input" type="tel" placeholder="8-digit ID" required maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                    </div>

                    <div class="input-group">
                        <label>Full Name</label>
                        <input asp-for="FullName" name="FullName" class="azam-input" placeholder="Enter your name" required />
                    </div>

                    <div class="niyyat-section">
                        <ul class="niyyat-list">
                            <li>I will keep my business 100% closed.</li>
                            <li>I will take leave from my professional job.</li>
                            <li>I will take leave from my academic studies.</li>
                            <li>I will arrive before time for all Majalis.</li>
                        </ul>

                        <label style="display:flex; align-items:center; gap:12px; color:var(--gold-deep); font-weight:600; cursor:pointer; font-size:0.9rem;">
                            <input asp-for="ConsentGiven" name="ConsentGiven" type="checkbox" id="consent" value="true" required style="accent-color:var(--gold-deep); width:18px; height:18px;" />
                            <span>I solemnly affirm this Azam.</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-submit" id="submitBtn">Confirm Azam Niyyat</button>
                </form>

                <div class="form-footer">
                    <p>PLANO JAMAAT</p>
                    <p style="font-size: 0.85rem; font-family: 'Inter', sans-serif; opacity: 0.8; margin-top: 4px;">PLANO</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const audio = document.getElementById('bgAudio');
    const audioBtn = document.getElementById('audioToggle');
    const audioIcon = document.getElementById('audioIcon');

    // Function to attempt playback
    function startAutoplay() {
        audio.play().then(() => {
            // Success: update UI
            audioIcon.innerText = "🔊";
            audioBtn.classList.add('playing');

            // Remove listeners once audio has successfully started
            document.removeEventListener('click', startAutoplay);
            document.removeEventListener('touchstart', startAutoplay);
            document.removeEventListener('keydown', startAutoplay);
        }).catch(error => {
            // Still blocked by browser; will try again on next click
            console.log("Autoplay waiting for user interaction...");
        });
    }

    // Listen for any interaction to trigger the "autoplay"
    document.addEventListener('click', startAutoplay);
    document.addEventListener('touchstart', startAutoplay);
    document.addEventListener('keydown', startAutoplay);

    // Manual Toggle Logic (in case they want to mute it)
    audioBtn.addEventListener('click', function(e) {
        e.stopPropagation(); // Prevent the 'click' listener above from firing
        if (audio.paused) {
            audio.play();
            audioIcon.innerText = "🔊";
            audioBtn.classList.add('playing');
        } else {
            audio.pause();
            audioIcon.innerText = "🔈";
            audioBtn.classList.remove('playing');
        }
    });

    // Form Loading Logic
    document.getElementById('azamForm').onsubmit = function () {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = "Submitting Niyyat...";
        return true;
    };
</script>